{
  "name": "ecotrak",
  "private": true,
  "packageManager": "yarn@1.22.18",
  "license": "MIT",
  "scripts": {
    "dev:web": "turbo run dev --filter=@ecotrack/app",
    "dev": "yarn run build:types && turbo run dev --filter=@ecotrack/app",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@ecotrack/app",
    "build:types": "turbo run build --filter=@ecotrack/types",
    "build:scripts": "turbo run build --filter=@ecotrack/scripts",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "deploy": "yarn build --force && vercel deploy",
    "deploy:dev": "cd scripts && tsx deploy.ts --dev",
    "deploy:prod": "cd scripts && tsx deploy.ts --prod"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  }
}