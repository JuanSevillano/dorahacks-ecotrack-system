# Figma API Configuration
# ========================
# Copy this file to .env.local and fill in your credentials
# DO NOT commit .env.local to git (it's in .gitignore)

# Your Figma Personal Access Token
# Get it from: https://www.figma.com/developers/api
# Steps:
#   1. Go to https://www.figma.com/settings/tokens
#   2. Click "Create a new token"
#   3. Copy and paste here (keep it secret!)
FIGMA_TOKEN=figd_your_token_here

# Your Figma file ID
# Get it from the URL when you open the file in Figma:
# https://figma.com/file/[THIS_IS_FILE_ID]/VerdeCap-Grant-Timeline
FIGMA_FILE_ID=abc123xyz...

# Your Figma team ID (optional, for webhooks)
# Get it from: https://www.figma.com/settings/teams (if you have a team)
FIGMA_TEAM_ID=your_team_id_optional

# ========================
# After filling in values, test with:
#   node @docs/figma-sync.js status
# ========================
